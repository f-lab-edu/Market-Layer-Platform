ARG AIRFLOW_VERSION=3.2.2
ARG PYTHON_VERSION=3.12
FROM apache/airflow:${AIRFLOW_VERSION}-python${PYTHON_VERSION}

ARG AIRFLOW_VERSION=3.2.2
ARG PYTHON_VERSION=3.12
ARG CONSTRAINTS_URL=https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt

USER airflow

COPY --chown=airflow:root requirements-airflow.txt /tmp/requirements-airflow.txt
RUN pip install --no-cache-dir --only-binary=:all: --constraint "${CONSTRAINTS_URL}" -r /tmp/requirements-airflow.txt

COPY --chown=airflow:root pyproject.toml README.md /opt/airflow/market-layer/
COPY --chown=airflow:root src /opt/airflow/market-layer/src
RUN pip wheel --no-cache-dir --no-deps --no-build-isolation --wheel-dir /tmp/market-layer-dist /opt/airflow/market-layer \
    && pip install --no-cache-dir --no-deps --only-binary=:all: /tmp/market-layer-dist/*.whl
