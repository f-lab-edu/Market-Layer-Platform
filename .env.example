# ============================================================
# Market-Layer-Platform — 환경변수 예시 (.env.example)
# 사용법: cp .env.example .env  후 실제 값 채우기. .env 는 .gitignore 처리됨(커밋 금지).
# [SECRET] = 비밀값(절대 커밋 X) / [CONFIG] = 일반 설정(민감하지 않음)
# 로컬 개발은 port-forward 기준 host(localhost). 클러스터 내부는 *.platform.svc 사용.
# ============================================================

# ---------- 데이터 소스 ----------
# FRED (매크로) — fred.stlouisfed.org → My Account 에서 발급  [SECRET]
FRED_API_KEY=

# SEC EDGAR — User-Agent 헤더 필수(이름 + 이메일). 미설정 시 403  [CONFIG]
SEC_USER_AGENT=Your Name your-email@example.com

# Reddit (attention proxy) — reddit.com/prefs/apps 에서 script 앱 생성  [SECRET]
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=market-layer-platform/0.1 by your_username   # [CONFIG]

# GDELT (뉴스) — API 키 불필요

# ---------- PostgreSQL (메타DB / Gold online / Bronze 운영메타) ----------
POSTGRES_HOST=localhost                 # [CONFIG] 클러스터 내부: postgresql.platform.svc.cluster.local
POSTGRES_PORT=5432                      # [CONFIG]
POSTGRES_USER=admin                     # [CONFIG]
POSTGRES_PASSWORD=                      # [SECRET]
# 용도별 DB 이름(라이브 기준)
PG_DB_AUDIT=audit                       # [CONFIG] Bronze 운영메타(bronze.ingestion_log 등)
PG_DB_MLFLOW=mlflow                     # [CONFIG]
PG_DB_FEAST=feast                       # [CONFIG] Gold online store
PG_DB_VECTOR=vector                     # [CONFIG] RAG 임베딩(pgvector)

# ---------- 데이터 레이크 (Bronze/Silver parquet) ----------
DATA_LAKE_ROOT=./data/lake              # [CONFIG] 클러스터(worker): /opt/airflow/data/lake

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://localhost:5000   # [CONFIG] 클러스터 내부: http://mlflow.platform.svc.cluster.local:5000

# ---------- 유니버스 / 런타임 ----------
TICKER_UNIVERSE=sp500                   # [CONFIG]
ENVIRONMENT=local                       # [CONFIG] local | cluster
LOG_LEVEL=INFO                          # [CONFIG]

# ---------- 서빙 (Week 3+ — 지금은 비워둬도 됨) ----------
# 텔레그램 모닝 브리프 봇  [SECRET]
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# LLM (브리프 자연어 표현 생성 — 택1)  [SECRET]
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
